{
  "lexicon": 1,
  "id": "net.sp00ky.juniper-pds.authority.juniperAdmission",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A community-actor decision admitting one exact self-submission.",
