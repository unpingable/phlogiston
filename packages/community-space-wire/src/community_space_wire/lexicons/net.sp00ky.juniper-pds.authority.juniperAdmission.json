        "required": ["submission", "subject", "authorizationOccurrence", "sourceObservationReceipt", "createdAt"],
        "properties": {
          "submission": {"type": "ref", "ref": "com.atproto.repo.strongRef"},
          "subject": {"type": "ref", "ref": "com.atproto.repo.strongRef"},
          "authorizationOccurrence": {"type": "string", "maxLength": 71},
          "sourceObservationReceipt": {"type": "string", "maxLength": 71},
          "createdAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
