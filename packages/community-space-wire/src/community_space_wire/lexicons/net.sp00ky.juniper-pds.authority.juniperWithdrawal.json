{
  "lexicon": 1,
  "id": "net.sp00ky.juniper-pds.authority.juniperWithdrawal",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "An author's exact prospective withdrawal from one Juniper admission.",
      "record": {
        "type": "object",
        "required": ["submission", "admission", "subject", "communityActor", "createdAt"],
        "properties": {
          "submission": {"type": "ref", "ref": "com.atproto.repo.strongRef"},
          "admission": {"type": "ref", "ref": "com.atproto.repo.strongRef"},
          "subject": {"type": "ref", "ref": "com.atproto.repo.strongRef"},
          "communityActor": {"type": "string", "format": "did"},
          "createdAt": {"type": "string", "format": "datetime"}
        }
      }
    }
  }
}
