# Secret-bearing deployment file lives only on the host with mode 0600.
PDS_HOSTNAME=juniper-pds.sp00ky.net
PDS_PORT=3001
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_REPO_SIGNING_KEY_K256_PRIVATE_KEY_HEX=GENERATE_ON_HOST
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=GENERATE_ON_HOST
PDS_DPOP_SECRET=GENERATE_ON_HOST
PDS_JWT_SECRET=GENERATE_ON_HOST
PDS_ADMIN_PASSWORD=GENERATE_ON_HOST
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_CRAWLERS=
PDS_INVITE_REQUIRED=1
PDS_DISABLE_SSRF_PROTECTION=0
PDS_OAUTH_PROVIDER_NAME=Juniper Commons disposable alpha
LOG_ENABLED=1
LOG_LEVEL=info
NODE_ENV=production
