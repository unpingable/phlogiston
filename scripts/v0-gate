#!/usr/bin/env python3
"""Root V0 gate: ./scripts/v0-gate TASK_ID

Side-effect-free probe. Runs the cumulative check suite, governance tests,
fixture validators, and the roadmap/authorization validator in V0-lane
mode, then emits a machine-readable requirement-coverage report. Exits 0
only on PASS. See governance/tools/v0_gate.py for the implementation and
the offline-preflight contract.
"""

import sys
from pathlib import Path

sys.path.insert(
    0, str(Path(__file__).resolve().parent.parent / "governance" / "tools")
)

import v0_gate

if __name__ == "__main__":
    raise SystemExit(v0_gate.main())
