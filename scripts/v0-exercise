#!/usr/bin/env python3
"""Controller-owned live exercise: ./scripts/v0-exercise OPERATION_ID --packet PATH

Launches the protected, digest-pinned exercise harness in a separate
process. The harness (governance/tools/v0_exercise.py) enforces the
packet's operation, target/DID/collection allow-lists, ceilings, and retry
bounds, and emits a schema-valid exercise receipt. This shim is trivial by
design: the packet's harness pin covers the enforcement module itself.
"""

import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
VENV_PYTHON = REPO_ROOT / ".venv" / "bin" / "python3"
MODULE = REPO_ROOT / "governance" / "tools" / "v0_exercise.py"

# Prefer the project-local virtual environment when present (same rule as
# scripts/check); re-exec so the harness runs under the pinned interpreter.
if VENV_PYTHON.exists() and Path(sys.executable).resolve() != VENV_PYTHON.resolve():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(MODULE), *sys.argv[1:]])

sys.path.insert(0, str(REPO_ROOT / "governance" / "tools"))

import v0_exercise

if __name__ == "__main__":
    raise SystemExit(v0_exercise.main())
